{
  "name": "dih-dah-dojo-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "test": "node --import tsx --test server/*.test.ts src/*.test.ts",
    "test:browser": "playwright test",
    "start": "node server-dist/index.mjs",
    "format": "prettier --write src server tests scripts public/*.js *.ts *.json *.jsonc index.html",
    "format:check": "prettier --check src server tests scripts public/*.js *.ts *.json *.jsonc index.html"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "better-auth": "1.7.23",
    "better-sqlite3": "13.1.1",
    "hono": "4.13.18",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.162.0"
  },
  "allowScripts": {
    "better-sqlite3@13.1.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true
  }
}
